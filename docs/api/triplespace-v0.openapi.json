{
  "openapi": "3.1.0",
  "info": {
    "title": "Triplespace REST API",
    "version": "0",
    "summary": "Data only Triplespace has, under rest.php/triplespace/v0 (ADR 0012 §1.3, §5).",
    "description": "The normative contract of the triplespace/v0 REST API. `v0` makes no stability promise yet (ADR 0005 §5). A route and its entry here change together. Every route is served per tenant base, which the request's host selects; responses are redacted for their viewer (ADR 0012 §8) and cached as ADR 0014 §6 has it: a public response carries `ETag`, `Cache-Control: public, max-age=0, s-maxage=60` and the `Cache-Tag` of every entity it drew on, and a request whose `If-None-Match` names the `ETag` gets `304`.",
    "license": {
      "name": "CC0-1.0",
      "identifier": "CC0-1.0"
    }
  },
  "servers": [
    {
      "url": "{base}/w/rest.php/triplespace/v0",
      "variables": {
        "base": {
          "default": "https://librarybase.org",
          "description": "A tenant base"
        }
      }
    },
    {
      "url": "{base}/rest.php/triplespace/v0",
      "variables": {
        "base": {
          "default": "https://librarybase.org"
        }
      }
    }
  ],
  "paths": {
    "/entity/{id}/provenance": {
      "get": {
        "operationId": "getEntityProvenance",
        "summary": "Where an entity and each of its statements come from",
        "description": "Which graphs hold a record for the entity, with their statement counts, sync state and history policy; the dominant graph; the graphs that assert each statement of the resolved view; the local corrections; who minted the ID; retention; the canonical ID (ADR 0003 §6, ADR 0012 §5). Fields whose projections are not built yet (cluster members, constraint results, the backlink count) are absent. A valid keyed ID that no graph holds answers with an empty provenance, as `wbgetentities` serves an empty entity for it (ADR 0009 §4).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "An entity ID in any form the Action API accepts: `Q6`, `XDQ12`, `domain:wikipedia.org`, `Item:Q6`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The provenance.",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Tag": {
                "description": "Public responses only: `entity:{id}`.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Provenance"
                }
              }
            }
          },
          "304": {
            "description": "The client's copy, named by `If-None-Match`, is current."
          },
          "400": {
            "description": "Not an entity ID, or one of no registered provider.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The caller lacks `read`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No such entity, or one the caller may not know exists (ADR 0056 §5).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "421": {
            "description": "The host is not a tenant of this instance.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/version": {
      "get": {
        "operationId": "getVersion",
        "summary": "Everything Special:Version shows",
        "description": "The credit line's parts (developer, contributors, funders), the licence and where the source of this build is, the build, the services the instance is configured to use with their states and (unless the instance's `version.services` setting withholds them) versions, the Triplespace crates and third-party components, the feature switches of the tenant (at a tenant base) or the instance (at the farm base), the entry points, the wikitext the tenant's expansion recognizes, the MediaWiki extensions that inspired features, the AI agents used, and the instance (ADR 0077 §10). `components_listed` is false for a build made without a component manifest; the component lists are then empty.",
        "parameters": [
          {
            "name": "If-None-Match",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "What Special:Version shows.",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Version"
                }
              }
            }
          },
          "304": {
            "description": "Not modified."
          },
          "421": {
            "description": "Not a tenant of this instance.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/version/licenses/{id}": {
      "get": {
        "operationId": "getComponentLicense",
        "summary": "One component's licence, copyright and notice files",
        "description": "The files a third-party crate, frontend package or vendored tree ships, as this build embeds them (ADR 0077 §3): what `Special:Version/License/{component}` serves.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The component's `name@version`, as `GET /version` lists it: `url@2.5.4`, `@wikimedia/codex@2.7.0`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The component and its files.",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComponentLicense"
                }
              }
            }
          },
          "304": {
            "description": "Not modified."
          },
          "404": {
            "description": "No component of that ID in this build.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "421": {
            "description": "Not a tenant of this instance.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/activity": {
      "get": {
        "operationId": "getActivity",
        "summary": "A change feed: recent changes, a history or contributions",
        "description": "Activity rows filtered by a target set (ADR 0020 §1–2; chapter 16 §4): without `target` or `actor`, the everything set, which is recent changes; with `target`, the one-target set, which is that entity's, page's, actor's or job's history; with `actor` alone, that actor's contributions. Rows are ordered by (time, partition, offset), newest first unless `dir=newer`, and paged with `next`, an opaque token the next request sends as `continue`. Every row is redacted for the viewer (ADR 0012 §8): a hidden part is named in `visibility` and absent from the row, and a row under a `read` restriction the viewer's groups do not satisfy is not returned. Mirror syncs (`kind: sync`) are left out of the everything set by default and kept in a target's history (chapter 16 §4.2); `syncs` overrides that. The related and watched sets and the stream are not served yet.",
        "parameters": [
          {
            "name": "target",
            "in": "query",
            "required": false,
            "description": "The one-target set: `{kind}:{id}` with kind `entity`, `page`, `actor`, `job` or `record`, such as `entity:Q6`, `page:12`, `actor:local:7`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "actor",
            "in": "query",
            "required": false,
            "description": "Rows by one actor, by user name or actor key: the contributions set when no `target` is given, an actor filter on the target's history otherwise.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "description": "Row kinds, `|`-separated: `edit`, `sync`, `log`, `job`, `erased`. Default: every kind but `sync` for the everything set, every kind for a target.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "syncs",
            "in": "query",
            "required": false,
            "description": "`on` or `off`: whether mirror syncs are included; a shorthand on `kind`.",
            "schema": {
              "type": "string",
              "enum": [
                "on",
                "off"
              ]
            }
          },
          {
            "name": "namespace",
            "in": "query",
            "required": false,
            "description": "Entity namespaces, `|`-separated (`120`, `122`, `210`, …), or `*`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tag",
            "in": "query",
            "required": false,
            "description": "Only rows carrying this change tag.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "job",
            "in": "query",
            "required": false,
            "description": "Only rows written by this job.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "exclude_actor",
            "in": "query",
            "required": false,
            "description": "No rows by this actor (name or key).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "log_type",
            "in": "query",
            "required": false,
            "description": "Only log events of this type.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "log_action",
            "in": "query",
            "required": false,
            "description": "… and this action.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "show",
            "in": "query",
            "required": false,
            "description": "Flag filters, `|`-separated: `bot`, `!bot`, `minor`, `!minor`, `new`, `!new`, `patrolled`, `!patrolled`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "description": "Rows at or after this time: ISO 8601 or MediaWiki's `YYYYMMDDHHMMSS`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "until",
            "in": "query",
            "required": false,
            "description": "Rows at or before this time.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "dir",
            "in": "query",
            "required": false,
            "description": "`older` (newest first, the default) or `newer`.",
            "schema": {
              "type": "string",
              "enum": [
                "older",
                "newer"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Rows per page: 50 by default, 500 at most.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            }
          },
          {
            "name": "continue",
            "in": "query",
            "required": false,
            "description": "The `next` token of the previous page.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "description": "The language of the targets' labels; `mul` and `en` are fallbacks.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One page of the feed.",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Tag": {
                "description": "Public responses only: `entity:{id}` for an entity's history, `activity` otherwise.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivityPage"
                }
              }
            }
          },
          "304": {
            "description": "Not modified."
          },
          "400": {
            "description": "A parameter the route does not take a value of (`bad-parameter`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The caller may not read (`permissiondenied`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "421": {
            "description": "The host is not a tenant of this instance (`misdirected`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "examples": [
              "entity-not-found",
              "invalid-entity-id",
              "permissiondenied",
              "misdirected"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Provenance": {
        "type": "object",
        "required": [
          "id",
          "canonical",
          "minted_by",
          "graphs",
          "statements",
          "corrections"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "The entity ID in canonical form."
          },
          "canonical": {
            "type": "string",
            "description": "The canonical ID of the entity's identity cluster (ADR 0004 §4); the ID itself when it is in none."
          },
          "type": {
            "type": "string",
            "examples": [
              "item",
              "property",
              "domain"
            ]
          },
          "page_id": {
            "type": "integer"
          },
          "lastrevid": {
            "type": [
              "integer",
              "null"
            ]
          },
          "modified": {
            "type": "string",
            "format": "date-time"
          },
          "first_seen": {
            "type": "string",
            "format": "date-time"
          },
          "retention": {
            "type": "string",
            "enum": [
              "cascade",
              "orphan",
              "retain"
            ]
          },
          "minted_by": {
            "$ref": "#/components/schemas/MintedBy"
          },
          "dominant": {
            "type": "string",
            "description": "The graph that asserts the most statements; a tie goes to the earlier graph, local first. Absent when no graph asserts any."
          },
          "graphs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GraphState"
            },
            "description": "Each graph that holds a record for the entity, local first."
          },
          "statements": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/StatementProvenance"
            },
            "description": "Keyed by the statement ID of the resolved view."
          },
          "corrections": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/Correction"
            },
            "description": "The tenant's corrections of mirrored statements (ADR 0002 §7), keyed by the statement ID they correct."
          }
        }
      },
      "MintedBy": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "kind",
              "tenant"
            ],
            "properties": {
              "kind": {
                "const": "tenant"
              },
              "tenant": {
                "type": "string"
              },
              "adopted_from": {
                "type": "string",
                "format": "uri",
                "description": "The wiki the tenant was adopted from (ADR 0035)."
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "provider"
              },
              "provider": {
                "type": "string"
              },
              "code": {
                "type": "string"
              },
              "upstream_id": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind",
              "type"
            ],
            "properties": {
              "kind": {
                "const": "keyed"
              },
              "type": {
                "type": "string",
                "description": "The keyed type; a keyed ID names the thing itself and is minted by no one (ADR 0017 §1)."
              }
            }
          }
        ]
      },
      "GraphState": {
        "type": "object",
        "required": [
          "graph",
          "statements",
          "synced_at"
        ],
        "properties": {
          "graph": {
            "type": "string",
            "examples": [
              "local",
              "mirror/wikidata"
            ]
          },
          "statements": {
            "type": "integer",
            "description": "How many statements the graph asserts."
          },
          "synced_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the graph's current record for the entity was written."
          },
          "upstream_version": {
            "type": "string",
            "description": "The upstream version that record carries, for a mirror."
          },
          "job": {
            "type": "integer",
            "description": "The job that wrote it."
          },
          "history": {
            "type": "string",
            "enum": [
              "full",
              "latest"
            ],
            "description": "The graph's history policy (ADR 0002 §2)."
          }
        }
      },
      "StatementProvenance": {
        "type": "object",
        "required": [
          "graphs",
          "members"
        ],
        "properties": {
          "graphs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The graphs that assert a member, in graph order."
          },
          "members": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The member statements' own IDs, in graph order (ADR 0004 §8)."
          }
        }
      },
      "Correction": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "rank"
            ],
            "properties": {
              "rank": {
                "type": "string",
                "enum": [
                  "preferred",
                  "normal",
                  "deprecated"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "suppressed"
            ],
            "properties": {
              "suppressed": {
                "const": true
              }
            }
          }
        ]
      },
      "Component": {
        "type": "object",
        "required": [
          "id",
          "name",
          "version",
          "license"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "`name@version`"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "license": {
            "type": "string",
            "description": "An SPDX licence expression"
          },
          "repository": {
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "type": "string",
            "description": "Vendored trees only: where the tree is in the repository"
          }
        }
      },
      "ComponentLicense": {
        "type": "object",
        "required": [
          "id",
          "name",
          "version",
          "license",
          "texts"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "repository": {
            "type": [
              "string",
              "null"
            ]
          },
          "texts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "file",
                "text"
              ],
              "properties": {
                "file": {
                  "type": "string"
                },
                "text": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      },
      "Version": {
        "type": "object",
        "required": [
          "product",
          "developer",
          "contributors",
          "funders",
          "license",
          "build",
          "services",
          "components_listed",
          "workspace",
          "crates",
          "packages",
          "vendored",
          "features",
          "entry_points",
          "wikitext",
          "inspired_by",
          "agents",
          "instance"
        ],
        "properties": {
          "product": {
            "type": "string"
          },
          "developer": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "place": {
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            }
          },
          "contributors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "since": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              }
            }
          },
          "funders": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "funded": {
                  "type": "string"
                },
                "since": {
                  "type": "string"
                },
                "until": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              }
            }
          },
          "license": {
            "type": "object",
            "required": [
              "spdx",
              "modified"
            ],
            "properties": {
              "spdx": {
                "type": "string"
              },
              "source": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Where the corresponding source is; null for a modified build whose instance names no `instance.source_url`"
              },
              "modified": {
                "type": "boolean"
              }
            }
          },
          "build": {
            "type": "object",
            "required": [
              "version"
            ],
            "properties": {
              "version": {
                "type": "string"
              },
              "commit": {
                "type": "string"
              },
              "modified": {
                "type": "boolean"
              },
              "commit_date": {
                "type": "string"
