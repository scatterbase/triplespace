                "type": "integer"
              },
              "offset": {
                "type": "integer"
              }
            }
          },
          "revid": {
            "type": "integer",
            "description": "The global revision ID of a change set."
          },
          "logid": {
            "type": "integer",
            "description": "The global log ID of an event."
          },
          "target": {
            "type": "object",
            "description": "Absent for a record with no target.",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "entity",
                  "page",
                  "actor",
                  "job",
                  "record"
                ]
              },
              "id": {
                "type": "string"
              },
              "member": {
                "type": "string",
