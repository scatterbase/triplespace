            "type": "boolean",
            "description": "Whether the tenant or the instance sets it; otherwise `value` is the default"
          },
          "value": {}
        }
      },
      "ActivityPage": {
        "type": "object",
        "required": [
          "rows",
          "set",
          "kinds"
