            "oneOf": [
              {
                "type": "string",
                "enum": [
                  "everything"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "properties": {
                  "actor": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          "kinds": {
            "type": "array",
