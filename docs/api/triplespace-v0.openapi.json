              "type": "string"
            },
            "description": "The row kinds the page covers."
          },
          "next": {
            "type": "string",
            "description": "The token of the next page; absent on the last."
          }
        }
      },
      "ActivityRow": {
        "type": "object",
        "description": "One activity row (chapter 16 §3.1).",
        "required": [
          "kind",
          "time",
          "source",
          "record",
          "actor",
          "tags",
          "flags",
          "patrolled",
          "visibility",
          "links"
        ],
        "properties": {
          "kind": {
            "type": "string",
