              },
              "entity_type": {
                "type": "string"
              },
              "page_id": {
                "type": "integer"
              },
              "ns": {
                "type": "integer"
              },
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "label": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string"
                  },
                  "language": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "actor": {
            "type": "object",
            "description": "`{hidden: true}` when the actor is hidden from the viewer.",
            "properties": {
              "key": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "iri": {
                "type": "string",
                "format": "uri"
              },
              "hidden": {
                "type": "boolean"
              }
            }
          },
          "operator": {
            "type": "string",
            "description": "A subsidiary's operator."
          },
          "requested_by": {
            "type": "string"
          },
          "job": {
            "type": "integer"
          },
          "summary": {
            "type": "object",
            "description": "The parsed summary (ADR 0001 §6), or `{hidden: true}`.",
            "properties": {
              "op": {
                "type": "string"
              },
              "args": {
                "type": "string"
              },
              "text": {
                "type": "string",
                "description": "MediaWiki's comment form: `/* op:args */ comment`."
              },
              "hidden": {
                "type": "boolean"
              }
            }
          },
          "comment": {
            "type": "string",
            "description": "The user's own comment."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "flags": {
            "type": "object",
            "required": [
              "minor",
              "bot",
              "new"
            ],
            "properties": {
              "minor": {
                "type": "boolean"
              },
              "bot": {
                "type": "boolean"
              },
              "new": {
                "type": "boolean"
              }
            }
          },
          "patrolled": {
            "type": "boolean"
          },
          "size": {
            "type": "integer"
          },
          "delta": {
            "type": "integer"
          },
          "changes": {
            "description": "A sync's change summary (ADR 0012 §2.2)."
          },
          "log": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "action": {
                "type": "string"
              },
              "params": {}
            }
          },
          "visibility": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "content",
                "comment",
                "user",
                "suppressed"
              ]
            },
            "description": "The parts hidden from the viewer."
          },
          "links": {
            "type": "object",
            "properties": {
              "diff": {
                "type": "string",
                "format": "uri"
              },
              "history": {
                "type": "string",
                "format": "uri"
              },
              "job": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        }
      }
    }
  }
