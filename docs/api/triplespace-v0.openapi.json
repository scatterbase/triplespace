              "edit",
              "sync",
              "log",
              "job",
              "erased"
            ]
          },
          "time": {
            "type": "string",
            "format": "date-time",
            "description": "When the event happened at its source."
          },
          "source": {
            "type": "string",
            "description": "The graph: `local`, `pages`, `mirror/wikidata`, `log`, …"
          },
